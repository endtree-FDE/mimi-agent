# Python
__pycache__/
*.pyc

# 填了真实飞书编号的机器人配置。仓库里只保留占位示例。
agents/*.json
!agents/example.json
!agents/config.schema.json

# 运行时状态、日志、记忆、审计
state/
state.db
*.db
logs/
tmp/
audit/
memory/
bot.pid
*.pid

# 本地会话的临时产物（测试输出、校验快照）。中间件只留在本机。
.temp/

# 播报运行产物：修数脚本和 pending 备份是本机运维痕迹，不是仓库内容。
broadcast/_*.ps1
broadcast/_pending_stdout.tmp
broadcast/*.bak*
broadcast/*.bak-*

# 知识库实数据。只保留空目录说明。
kb/*
!kb/请把资料放在这里.md
kb_inbox/
kb_staging/
kb_prev/
kb_new/
bundles/
uploads/

# 播报正文。只提交样子，不提交填好的几行。
broadcast/brief.txt
broadcast/pending.txt

# 接待桥攒下来的合作意向。里面是陌生访客写的话，绝不提交。
intake/leads.md

# 客户名名单和本地密钥。不要提交填好的文件。
redact.txt
redact_candidates.txt
.env
.env.*
!.env.example

# 本地工具缓存
agent-tools/
**/.attach/

# 回答质量回归的报告和沙箱。基线在 evals/baseline/，可以提交。
evals/out/
