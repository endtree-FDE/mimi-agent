{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "$id": "agents/config.schema.json",
  "title": "飞书群智能体配置",
  "description": "缺了的键保持旧行为。不认识的键先留着，不因此判失败。密钥不要写进这个文件。",
  "type": "object",
  "additionalProperties": true,
  "properties": {
    "name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 40
    },
    "base_dir": {
      "type": "string"
    },
    "kb_dir": {
      "type": "string"
    },
    "profile": {
      "type": "string"
    },
    "bot_open_id": {
      "type": "string"
    },
    "bot_names": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "chat_ids": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "reply_in_thread": {
      "type": "boolean"
    },
    "max_concurrency": {
      "type": "integer",
      "minimum": 1
    },
    "max_queue": {
      "type": "integer",
      "minimum": 0
    },
    "model_provider": {
      "type": "string",
      "enum": [
        "cursor",
        "openai_compat",
        "openai_compatible",
        "anthropic",
        "claude",
        "fake",
        "deepseek",
        "dashscope",
        "zhipu",
        "pangu"
      ]
    },
    "model": {
      "type": "object",
      "additionalProperties": true,
      "description": "可替换的模型。不写时仍用 model_provider，没写就是 cursor。密钥只写环境变量名。",
      "properties": {
        "provider": {
          "type": "string",
          "enum": [
            "",
            "cursor",
            "openai_compat",
            "openai_compatible",
            "anthropic",
            "claude",
            "fake",
            "deepseek",
            "dashscope",
            "zhipu",
            "pangu"
          ]
        },
        "preset": {
          "type": "string",
          "enum": ["", "deepseek", "dashscope", "zhipu", "pangu"]
        },
        "base_url": {
          "type": "string",
          "pattern": "^$|^https?://\\S+$"
        },
        "model": {
          "type": "string"
        },
        "api_key_env": {
          "type": "string",
          "pattern": "^$|^[A-Za-z_][A-Za-z0-9_]{0,80}$"
        },
        "temperature": {
          "type": "number",
          "minimum": 0,
          "maximum": 2
        },
        "timeout_sec": {
          "type": "number",
          "minimum": 0
        },
        "max_tokens": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "search": {
      "type": "object",
      "additionalProperties": true,
      "description": "可选网页搜索。不写或 enabled 为 false 时不调用。",
      "properties": {
        "enabled": {"type": "boolean"},
        "backend": {
          "type": "string",
          "enum": ["", "tavily", "searxng", "searx"]
        },
        "base_url": {"type": "string"},
        "api_key_env": {
          "type": "string",
          "pattern": "^$|^[A-Za-z_][A-Za-z0-9_]{0,80}$"
        },
        "timeout_sec": {"type": "number", "minimum": 0},
        "max_results": {"type": "integer", "minimum": 1}
      }
    },
    "dry_run_live_reads": {
      "type": "boolean"
    },
    "redact_file": {
      "type": "string"
    },
    "help_pattern": {
      "type": "string"
    },
    "system_prompt": {
      "type": "string"
    },
    "kb_index": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "budget_chars": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "chats": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "auto_join": {
          "type": "boolean"
        },
        "admit": {
          "type": "string"
        },
        "inviter_open_ids": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "catchup": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "overlap_sec": {
          "type": "integer",
          "minimum": 0
        },
        "max_messages": {
          "type": "integer",
          "minimum": 0
        },
        "max_age_sec": {
          "type": "integer",
          "minimum": 0,
          "description": "补答最多回溯多少秒。不写是 43200。0 表示不再另加时限。"
        }
      }
    },
    "thread_followup": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "who": {
          "type": "string"
        }
      }
    },
    "rate_limit": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "min_gap_per_user": {
          "type": "number",
          "minimum": 0
        },
        "max_per_hour": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "commands": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "status": {
          "type": "boolean",
          "description": "不写或 true 时，/状态、/status 或单独一个「状态」不调用模型。false 时这几个字仍交给模型。"
        }
      }
    },
    "observability": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "journal": {
          "type": "boolean"
        },
        "calls": {
          "description": "不写或 enabled 不为 false 时，每轮回答在 logs/calls.jsonl 记一条已脱敏的调用链。false 表示不记。",
          "oneOf": [
            {"type": "boolean"},
            {
              "type": "object",
              "additionalProperties": true,
              "properties": {
                "enabled": {"type": "boolean"},
                "retain_days": {"type": "integer", "minimum": 1}
              }
            }
          ]
        }
      }
    },
    "alerts": {
      "type": "object",
      "additionalProperties": true,
      "description": "长连接或心跳不健康时通知主人。不写或 enabled 为 false 时不发消息。restart_* 只管诊断里的退出累计，不影响提醒发送。",
      "properties": {
        "enabled": {"type": "boolean"},
        "owner_open_ids": {"type": "array", "items": {"type": "string"}},
        "unhealthy_after_sec": {"type": "number", "minimum": 0},
        "repeat_sec": {"type": "number", "minimum": 0},
        "restart_window_sec": {"type": "number", "minimum": 0},
        "restart_warn_after": {"type": "number", "minimum": 0},
        "local_log": {"type": "boolean"},
        "windows_toast": {"type": "boolean"}
      }
    },
    "digest": {
      "type": "object",
      "additionalProperties": true,
      "description": "到点往指定群发一条今日摘要。不写或 enabled 为 false 时不发。",
      "properties": {
        "enabled": {"type": "boolean"},
        "time": {"type": "string"},
        "timezone": {"type": "string"},
        "chat_ids": {"type": "array", "items": {"type": "string"}},
        "window_min": {"type": "integer", "minimum": 0},
        "include_calendar": {"type": "boolean"},
        "include_tasks": {"type": "boolean"},
        "status_field": {"type": "string"},
        "title_field": {"type": "string"},
        "done_values": {"type": "array", "items": {"type": "string"}}
      }
    },
    "broadcast": {
      "type": "object",
      "additionalProperties": true,
      "description": "到点往指定群发一条只读播报。不写或 enabled 为 false 时不发。不调用模型，不读日历和任务表。body_file、command、text、urls 可以同时使用。",
      "properties": {
        "enabled": {"type": "boolean"},
        "time": {"type": "string"},
        "timezone": {"type": "string"},
        "chat_ids": {"type": "array", "items": {"type": "string"}},
        "window_min": {"type": "integer", "minimum": 0},
        "title": {"type": "string"},
        "source": {"type": "string"},
        "body_file": {"type": "string"},
        "command": {"type": "array", "items": {"type": "string"}},
        "timeout_sec": {"type": "integer", "minimum": 1},
        "text": {"type": "string"},
        "urls": {"type": "array", "items": {"type": "string"}}
      }
    },
    "report": {
      "type": "object",
      "additionalProperties": true,
      "description": "每周私聊主人一份用量合计。不写或 enabled 为 false 时不发。",
      "properties": {
        "enabled": {"type": "boolean"},
        "owner_open_ids": {"type": "array", "items": {"type": "string"}},
        "weekday": {"type": ["string", "integer"]},
        "time": {"type": "string"},
        "timezone": {"type": "string"},
        "window_min": {"type": "integer", "minimum": 0}
      }
    },
    "intake": {
      "type": "object",
      "additionalProperties": true,
      "description": "接待桥：定时从公网 HTTPS 端点拉合作意向，去重后追加写进一个待审文件。只进不出，自己不发任何消息。不写或 enabled 为 false 时完全不参与。",
      "properties": {
        "enabled": {"type": "boolean"},
        "url": {"type": "string", "description": "对端地址。必须是公网 http(s)；内网、带账号密码、地址里夹密钥的一律视为没配。"},
        "token_env": {"type": "string", "description": "存放密钥的环境变量名。配置里只写变量名，不写值；变量为空则这一轮不去拉。"},
        "interval_min": {"type": "integer", "minimum": 15, "maximum": 1440},
        "timeout_sec": {"type": "integer", "minimum": 1, "maximum": 20},
        "timezone": {"type": "string"},
        "out_file": {"type": "string", "description": "待审文件，相对实例目录。绝对路径、盘符、.. 一律回到默认值。"},
        "notify": {
          "type": "object",
          "additionalProperties": true,
          "description": "待看提醒。默认关。开着时到点给主人私聊发一条「有 N 条待看」并附确认码；主人在私聊本人回复确认码之后才把那几条发到 chat_ids 里的群。不回复、回复错的人、码过期都不发。",
          "properties": {
            "enabled": {"type": "boolean"},
            "owner_open_ids": {"type": "array", "items": {"type": "string"}, "description": "收提醒的主人编号。空着沿用 report/alerts 那一份。"},
            "chat_ids": {"type": "array", "items": {"type": "string"}, "description": "确认之后往哪些群发。只发已经在服务范围内的群。"},
            "min_items": {"type": "integer", "minimum": 1, "maximum": 50},
            "max_per_day": {"type": "integer", "minimum": 1, "maximum": 10},
            "min_gap_min": {"type": "integer", "minimum": 5, "maximum": 1440},
            "max_items": {"type": "integer", "minimum": 1, "maximum": 20},
            "confirm_ttl_sec": {"type": "integer", "minimum": 60, "maximum": 604800},
            "timezone": {"type": "string"}
          }
        }
      }
    },
    "features": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "memory": {
          "type": "boolean"
        },
        "p2p": {
          "type": "boolean"
        },
        "tools": {
          "type": "boolean"
        },
        "attachments": {
          "type": "boolean"
        },
        "vision": {
          "type": "boolean"
        }
      }
    },
    "memory": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "dir": {
          "type": "string"
        },
        "profile_budget_chars": {
          "type": "integer",
          "minimum": 0
        },
        "recall": {
          "type": "boolean"
        },
        "recall_budget_chars": {
          "type": "integer",
          "minimum": 0
        },
        "max_fact_chars": {
          "type": "integer",
          "minimum": 0
        },
        "scope": {
          "type": "string"
        },
        "max_turns": {
          "type": "integer",
          "minimum": 0
        },
        "max_turn_chars": {
          "type": "integer",
          "minimum": 0,
          "description": "记进短期记忆的一条最多多少字，只留开头。不写是 2000。0 表示整段都留。"
        },
        "context_budget_chars": {
          "type": "integer",
          "minimum": 0
        },
        "ttl_hours": {
          "type": "number",
          "minimum": 0
        },
        "per_user": {
          "type": "boolean"
        },
        "trim_note": {
          "type": "boolean",
          "description": "不写或 true：超字数预算丢掉旧对话时，在提示词里注明省略了几条。false 则静默丢掉。"
        },
        "growth": {
          "type": "object",
          "additionalProperties": true,
          "description": "从近期对话提议长期记忆。不写或 enabled 为 false 时不调用模型，也不改账本。",
          "properties": {
            "enabled": {"type": "boolean"},
            "approver_open_ids": {"type": "array", "items": {"type": "string"}},
            "deliver": {"type": "string"},
            "time": {"type": "string"},
            "timezone": {"type": "string"},
            "window_min": {"type": "integer", "minimum": 0},
            "on_schedule": {"type": "boolean"},
            "on_idle": {"type": "boolean"},
            "idle_min": {"type": "integer", "minimum": 0},
            "lookback_hours": {"type": "integer", "minimum": 0},
            "max_messages": {"type": "integer", "minimum": 0},
            "max_proposals": {"type": "integer", "minimum": 0},
            "review_days": {"type": "integer", "minimum": 0},
            "status_days": {"type": "integer", "minimum": 0},
            "deadline_grace_days": {"type": "integer", "minimum": 0},
            "offer_gap_days": {"type": "integer", "minimum": 0},
            "min_confidence": {"type": "number", "minimum": 0},
            "dedupe_ratio": {"type": "number", "minimum": 0},
            "confirm_ttl_sec": {"type": "integer", "minimum": 0},
            "forget_ttl_sec": {"type": "integer", "minimum": 0}
          }
        },
        "retrospect": {
          "type": "object",
          "additionalProperties": true,
          "description": "一轮做完后提议一句短复盘。不写或 enabled 为 false 时不提议，也不改事实。",
          "properties": {
            "enabled": {"type": "boolean"}
          }
        }
      }
    },
    "skills": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "dir": {
          "type": "string"
        },
        "only": {
          "description": "不写、空数组或 false：合法技能全部选用。字符串或字符串数组才收窄目录、预放和 skill_read。创作流程可点名 topic-ideation、short-video-script、storyboard、aigc-prompt-pack、creative-brief、post-mortem。example.json 里仍是空数组。",
          "anyOf": [
            {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            {
              "type": "boolean"
            },
            {
              "type": "string"
            }
          ]
        },
        "index_budget_chars": {
          "type": "integer",
          "minimum": 0
        },
        "preload": {
          "type": "boolean"
        },
        "preload_budget_chars": {
          "type": "integer",
          "minimum": 0
        },
        "evolve": {
          "type": "object",
          "additionalProperties": true,
          "description": "根据调用和复盘提议技能下一版。不写或 enabled 为 false 时不提议，也不改 SKILL.md。",
          "properties": {
            "enabled": {"type": "boolean"},
            "cases": {"type": "array", "items": {"type": "string"}}
          }
        }
      }
    },
    "p2p": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "allow_open_ids": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "open_to_all": {
          "type": "boolean"
        },
        "allow_group_members": {
          "type": "boolean",
          "description": "为 true 时，所服务群的当前成员可以私聊。不写或 false 时不查群成员。"
        },
        "member_cache_ttl_sec": {
          "type": "integer",
          "minimum": 0,
          "description": "群成员名单缓存秒数。不写是 600。失败时上次成功的名单最多再沿用两倍。"
        }
      }
    },
    "agent": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "mode": {
          "type": "string"
        },
        "preset": {
          "type": "string",
          "enum": [
            "",
            "deepseek",
            "dashscope",
            "zhipu",
            "pangu"
          ]
        },
        "model": {
          "type": "string"
        },
        "base_url": {
          "type": "string",
          "pattern": "^$|^https?://\\S+$"
        },
        "api_key_env": {
          "type": "string",
          "pattern": "^$|^[A-Za-z_][A-Za-z0-9_]{0,80}$"
        },
        "network_retries": {
          "type": "integer",
          "minimum": 0
        },
        "max_runtime_sec": {
          "type": "number",
          "minimum": 0
        },
        "stall_sec": {
          "type": "number",
          "minimum": 0
        },
        "max_chars": {
          "type": "integer",
          "minimum": 0
        },
        "body_max_chars": {
          "type": "integer",
          "minimum": 0
        },
        "reply_chunk_chars": {
          "type": "integer",
          "minimum": 0
        },
        "max_tool_rounds": {
          "type": "integer",
          "minimum": 0,
          "description": "只读工具最多连续几轮。不写是 4。小于 1 时按 1。每一轮可以按顺序执行多条只读调用。"
        },
        "crew": {
          "type": "object",
          "additionalProperties": true,
          "description": "复杂问题交给主理人和只读专员。不写或 enabled 为 false 时回答路径不变。",
          "properties": {
            "enabled": {"type": "boolean"},
            "total_rounds": {"type": "integer", "minimum": 0},
            "step_rounds": {"type": "integer", "minimum": 0},
            "total_tokens": {"type": "integer", "minimum": 0},
            "step_tokens": {"type": "integer", "minimum": 0},
            "total_sec": {"type": "integer", "minimum": 0},
            "step_sec": {"type": "integer", "minimum": 0}
          }
        },
        "tool_context_budget_chars": {
          "type": "integer",
          "minimum": 0,
          "description": "多轮工具结果累积重发的字数预算。不写是 120000。超过时先压缩较早的结果，仍超就截断并注明。0 表示不设预算。"
        },
        "progress_heartbeat_sec": {
          "type": "number",
          "minimum": 0,
          "description": "作答时隔多少秒记进度心跳。不写是 20。0 表示不打这条心跳。"
        }
      }
    },
    "texts": {
      "type": "object",
      "additionalProperties": {
        "type": "string"
      }
    },
    "policy": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "redlines": {
          "type": "array"
        }
      }
    },
    "knowledge": {
      "type": "object",
      "additionalProperties": true,
      "description": "分群知识库检索。不写或 enabled 为 false 时不收录、不检索，提示词和命令与以前一样。",
      "properties": {
        "enabled": {"type": "boolean"},
        "auto_retrieve": {"type": "boolean"},
        "local": {"type": "boolean"},
        "group_files": {"type": "boolean"},
        "group_links": {"type": "boolean"},
        "refresh_min": {"type": "integer", "minimum": 0},
        "docs": {"type": "array", "items": {"type": "string"}},
        "wiki": {"type": "array", "items": {"type": "string"}},
        "bases": {"type": "array"},
        "chunk_chars": {"type": "integer", "minimum": 0},
        "chunk_overlap": {"type": "integer", "minimum": 0},
        "top_k": {"type": "integer", "minimum": 0},
        "max_chars": {"type": "integer", "minimum": 0},
        "max_source_chars": {"type": "integer", "minimum": 0},
        "embeddings": {
          "type": "object",
          "additionalProperties": true,
          "properties": {
            "enabled": {"type": "boolean"},
            "base_url": {"type": "string"},
            "api_key_env": {"type": "string"},
            "model": {"type": "string"},
            "timeout_sec": {"type": "integer", "minimum": 0}
          }
        }
      }
    },
    "kb_sync": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "docs_tokens": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "confirm": {
      "type": "object",
      "additionalProperties": true,
      "description": "写入和开关的确认方式。不写时默认点按钮。飞书没开通卡片回调时自动改用确认码。不能写成关掉。",
      "properties": {
        "mode": {
          "type": "string",
          "enum": ["button", "code", "button_or_code", "button_and_code"]
        },
        "high_risk_mode": {
          "type": "string",
          "enum": ["button", "code", "button_or_code", "button_and_code"],
          "description": "批量写入、改功能开关、重启这一类。不写时和 mode 相同。"
        },
        "ttl_sec": {
          "type": "integer",
          "minimum": 1,
          "description": "按钮有效秒数。不写是 600。"
        },
        "code_ttl_sec": {
          "type": "integer",
          "minimum": 1,
          "description": "确认码有效秒数。不写时沿用 write.confirm_ttl_sec。"
        },
        "code_digits": {
          "type": "integer",
          "minimum": 4,
          "maximum": 8,
          "description": "确认码位数。不写是 6。"
        },
        "card_callback": {
          "type": "string",
          "enum": ["auto", "on", "off"],
          "description": "要不要启动卡片回调接收进程。不写是 auto：启动前探测，没订阅就不起、这次运行也不再重启，确认改用确认码。on 总是启动，没订阅则退出后不再重启。off 不启动。"
        }
      }
    },
    "write": {
      "type": "object",
      "additionalProperties": true,
      "description": "写入开关与白名单。decision_gate 子键是 juchang 决策门禁：声明哪些写工具过门禁、各是什么等级。",
      "properties": {
        "decision_gate": {
          "type": "object",
          "additionalProperties": true,
          "description": "写提案决策门禁（juchang-decision-gate）。默认关。tools 里没点名的写工具不过门禁；等级只能是 L1/L2/L3，写错时该写动作被拒绝（fail closed）。",
          "properties": {
            "enabled": {
              "type": "boolean"
            },
            "tools": {
              "type": "object",
              "additionalProperties": true,
              "description": "写工具名 → 等级（如 \"docs_create\": \"L2\"）或对象（\"level\" 加可选的 reversibility/complexity/likelihood/impact 覆盖）。"
            },
            "evidence_window_sec": {
              "type": "integer",
              "minimum": 0,
              "description": "本会话最近一次 evidencegate_check 路由多久内可当作证据状态。不写是 900。"
            },
            "evidence_default": {
              "type": "string",
              "enum": ["sufficient", "partial", "conflict", "missing"],
              "description": "没有近期证据检查时的默认证据状态。不写是 sufficient。"
            },
            "node": {
              "type": "string",
              "description": "Node 可执行文件名或路径。不写用 node（或 tools.decision_gate_check.node）。"
            }
          }
        },
        "review_roster": {
          "type": "object",
          "additionalProperties": true,
          "description": "双人复核值班表。默认关。enabled 不是 true 时，第二位仍是任意另一位写入白名单管理员。打开后只能收窄到当前班次，且值班人还必须在 allowed_users 里。不把日常 L2 抬成 dual，也不关确认。",
          "properties": {
            "enabled": {
              "type": "boolean"
            },
            "utc_offset_hours": {
              "type": "integer",
              "minimum": -12,
              "maximum": 14,
              "description": "相对 UTC 的小时数。不写用运行机器人的那台电脑的本地时间。东八区写 8。写错时这一时段没有人能复核。"
            },
            "slots": {
              "type": "array",
              "description": "班次。weekdays 用 1 到 7（1 是周一）。start 含、end 不含；end 可以是 24:00。end 早于 start 表示跨过午夜，早晨算前一天。",
              "items": {
                "type": "object",
                "additionalProperties": true,
                "properties": {
                  "weekdays": {
                    "type": "array",
                    "items": {
                      "type": "integer",
                      "minimum": 1,
                      "maximum": 7
                    }
                  },
                  "start": {
                    "type": "string"
                  },
                  "end": {
                    "type": "string"
                  },
                  "open_ids": {
                    "type": "array",
                    "items": {
                      "type": "string"
                    },
                    "description": "这一班可以复核的人的编号。必须同时出现在 write.allowed_users 的左边。"
                  }
                }
              }
            }
          }
        }
      }
    },
    "progress": {
      "type": "object",
      "additionalProperties": true
    },
    "tools": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "history": {
          "type": "object",
          "additionalProperties": true,
          "properties": {
            "enabled": {
              "type": "boolean"
            },
            "days": {
              "type": "integer",
              "minimum": 0
            },
            "max_pages": {
              "type": "integer",
              "minimum": 0
            },
            "page_size": {
              "type": "integer",
              "minimum": 1,
              "description": "拉群消息时每页条数。不写是 50。停机补答也用这个数。"
            },
            "max_lines": {
              "type": "integer",
              "minimum": 0,
              "description": "交给模型的历史最多几行。不写是 150。超过时注明还剩几行。0 表示不截断。"
            }
          }
        },
        "docs_search": {
          "type": "object",
          "additionalProperties": true,
          "properties": {
            "enabled": {
              "type": "boolean"
            },
            "max_chars": {
              "type": "integer",
              "minimum": 0,
              "description": "搜索结果最多多少字。不写是 4000。0 表示不截断。"
            }
          }
        },
        "calendar_read": {
          "type": "object",
          "additionalProperties": true,
          "properties": {
            "enabled": {
              "type": "boolean"
            },
            "max_chars": {
              "type": "integer",
              "minimum": 0,
              "description": "日程结果最多多少字。不写是 4000。0 表示不截断。"
            }
          }
        },
        "base_read": {
          "type": "object",
          "additionalProperties": true,
          "properties": {
            "enabled": {
              "type": "boolean"
            },
            "max_chars": {
              "type": "integer",
              "minimum": 0,
              "description": "表格结果最多多少字。不写是 5000。0 表示不截断。"
            }
          }
        },
        "evidencegate_check": {
          "type": "object",
          "additionalProperties": true,
          "description": "EvidenceGate 门禁：校验文档 AI 输出并返回三路由与字段证据。默认关。",
          "properties": {
            "enabled": {
              "type": "boolean"
            },
            "schema": {
              "type": "string",
              "description": "门禁契约 JSON 的实例内相对路径。不写用 skills/evidencegate-ocr/scripts/evidence-schema.json。"
            },
            "node": {
              "type": "string",
              "description": "Node 可执行文件名或路径。不写用 node。"
            }
          }
        },
        "decision_gate_check": {
          "type": "object",
          "additionalProperties": true,
          "description": "juchang 决策门禁查询：按证据状态×动作等级×可逆性算出路由与理由。只读，不执行。默认关。",
          "properties": {
            "enabled": {
              "type": "boolean"
            },
            "node": {
              "type": "string",
              "description": "Node 可执行文件名或路径。不写用 node。脚本固定用 skills/juchang-decision-gate/scripts/。"
            }
          }
        },
        "evidence_replay_check": {
          "type": "object",
          "additionalProperties": true,
          "description": "据场证据回放核对：校验回放归档 JSON 的三模式标签、哈希与缺口登记。只读。默认关。",
          "properties": {
            "enabled": {
              "type": "boolean"
            },
            "node": {
              "type": "string",
              "description": "Node 可执行文件名或路径。不写用 node。脚本固定用 skills/juchang-evidence-replay/scripts/。"
            }
          }
        },
        "receipt_verify": {
          "type": "object",
          "additionalProperties": true,
          "description": "Matrix 回执核验：离线校验 caller 提供的 accepted@2 导出。结果只证明内部一致。默认关。",
          "properties": {
            "enabled": {
              "type": "boolean"
            },
            "node": {
              "type": "string",
              "description": "Node 可执行文件名或路径。不写用 node。脚本固定用 skills/matrix-receipt-verifier/scripts/。"
            }
          }
        },
        "message_attachment": {
          "type": "object",
          "additionalProperties": true,
          "description": "读取当前会话里某条历史消息的附件。没写时跟着 attachment.enabled。",
          "properties": {
            "enabled": {
              "type": "boolean"
            },
            "max_per_answer": {
              "type": "integer",
              "minimum": 0
            }
          }
        },
        "kb_read": {
          "type": "object",
          "additionalProperties": true,
          "properties": {
            "enabled": {
              "type": "boolean"
            },
            "max_chars": {
              "type": "integer",
              "minimum": 0
            }
          }
        },
        "attachment": {
          "type": "object",
          "additionalProperties": true,
          "properties": {
            "enabled": {
              "type": "boolean"
            },
            "pdf_scan_pages": {
              "type": "integer",
              "minimum": 0,
              "description": "PDF 没有文字时，最多抽出前几页里的内嵌图片。不写是 10。"
            }
          }
        }
      }
    },
    "conflict_pidfiles": {
      "type": "array"
    },
    "shutdown_wait_sec": {
      "type": "number",
      "minimum": 0,
      "description": "停机最多再等几秒。不写是 15。0 表示马上退出。"
    },
    "link_jump_sec": {
      "type": "number",
      "minimum": 0,
      "description": "休眠超过这么多秒就重连长连接。不写是 20。0 表示不因为休眠重连。"
    }
  }
}
